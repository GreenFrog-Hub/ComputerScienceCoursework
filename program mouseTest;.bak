program mouseTest;

uses
  crt, Opmouse;

begin
  clrscr;
  writeln('Mouse Test Program');
  writeln('Press any key to exit.');

  // Initialize mouse
  {if not MouseInit then
  begin
    writeln('Mouse not found.');
    readln;
    halt(1);
  end;
  }
  // Show mouse cursor
  InitializeMouse;
  Showmouse;

  // Main loop
  while not keypressed do
  begin
    // Get mouse position and button status
    write('Mouse Position: (', MouseWhereXabs, ', ', MouseWhereYabs, ')');
    //writeln('Mouse Buttons: ', MouseButtons);
    GOTOXY(1,3);
    delay(100); // Delay to reduce CPU usage
  end;

  // Hide mouse cursor and clean up

  writeln('Exiting...');
  readln;
end.
