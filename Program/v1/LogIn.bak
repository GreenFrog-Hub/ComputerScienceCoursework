unit LogIn;
  interface
  uses crt, sysutils, vputils;

  TYPE userPassArray = ARRAY[0..1] OF STRING;

  VAR Username, Password : STRING;
    y : LONGINT;
    userPass : userPassArray;

  procedure GetUsername;
  procedure GetPassword;
    var i, a : LONGINT;
    key : CHAR;
  procedure startLogIn(var userPassArrayr : ARRAY OF STRING);


  implementation

  PROCEDURE GetUsername;
      begin
        GotoXY(11,1);
        READLN(username);
      end;

  PROCEDURE GetPassword;
    var i,a : LONGINT;
    key : CHAR;
    begin
      GoToXY(11,2);
      i := 0;
      HideCursor;
      password := '';
      repeat
        key := readkey;
          if (key = #8) THEN
            begin
              if i > 0 THEN
                begin
                  Delete(password,i,1);
                  i := i -1;
                end;
            end

          else if ((key >= #33) and (key < #127) and (key <> #13)) OR (key = #156) THEN
            begin
              password := password + key;
              i := i +1;
            end;
          GoToXY(1,2);
          DelLine;
          Write('Password: ');
          for a := 1 TO i DO
            write(#15);
    until key = #13;
      writeln;
      userPass[1] := password;
      ClrScr;
    end;


  PROCEDURE DisplayInfo;
    Begin
      WRITELN('Username: ');
      WRITELN('Password: ');
      GoToXY(11,1);
    end;

  procedure startLogIn(var userPassArrayr : ARRAY OF STRING);
    begin
      DisplayInfo;
      GetUsername;
      GetPassword;
      //writeln(userPass[0]);
      userPassArrayr[0] := username;
      userPassArrayr[1] := password;
    end;
  end.
