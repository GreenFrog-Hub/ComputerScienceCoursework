PROGRAM FileProcedures;
{$M+}
    //interface

    USES crt, sysutils;

    TYPE
        StudentsRecord = RECORD
                          StudentID : LONGINT;
                          FName : STRING;
                          SName : String;
                          Year : LONGINT;
                          Form : STRING;
                          Uname : String;
                          Pword : String;
                          Attendance : real;
                        end;


        Files = class
            public
                procedure printArray(b:LONGINT);
        end;


        StudentFile = class(Files)
            protected
                data : StudentsRecord;
                dataFile: File OF StudentsRecord;

            public
                indexArray: ARRAY[0..10] OF LONGINT;
                constructor Create;
                procedure SetData(StudentId : LONGINT; FirstName: STRING; SurName : STRING; SYear : LONGINT; SForm : STRING; SUname : String; SPword : String; SAttendance : real);
                procedure DisplayData;
                procedure writeToFile;
                procedure readHere;
                procedure readFile(readFromPosition : LONGINT);
        end;

    //IMPLEMENTATION


    procedure Files.printArray(b:LONGINT);
      var
        a : LONGINT;
        begin
            for a := 0 TO 10 DO
                writeln(indexArray[a]);
        end;



    constructor StudentFile.Create;
        begin
            ASSIGN(dataFile,'C:\ComputerScienceCoursework\Program\files\Students.dta');
            for a := 0 TO 10 DO
                indexArray[a] := a;
        end;

    procedure StudentFile.SetData(StudentId : LONGINT;
                          FirstName : STRING;
                          SurName : STRING;
                          SYear : LONGINT;
                          SForm : STRING;
                          SUname : String;
                          SPword : String;
                          SAttendance : real);
        begin
            with data do
                begin
                    StudentID := StudentId;
                    FName := FirstName;3
                    SName := SurName;
                    Year := SYear;
                    Form := SForm;
                    Uname := SUname;
                    Pword := SPword;
                    Attendance := SAttendance;
                end;
        end;

    procedure StudentFile.DisplayData;
        begin
        with data do
            begin
                writeln(data.StudentID);
                writeln(data.FName);
                writeln(data.SName);
                writeln(data.Year);
                writeln(data.Form);
                writeln(data.Uname);
                writeln(data.Attendance);
            end;
        end;

    procedure StudentFile.writeToFile;
        begin
            write(dataFile, data)
        end;


    procedure StudentFile.readHere;
        begin
            read(dataFile,data);
        end;

    procedure StudentFile.readFile(readFromPosition : LONGINT);
        begin
            if readFromPosition < FileSize(dataFile) then
                begin
                    SEEK(dataFile,readFromPosition);
                    read(dataFile,data);
                end;
        end;

    begin
        Student := StudentFile.Create;
        Student.printArray;
    END.


