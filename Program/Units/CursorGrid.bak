UNIT CursorGrid;
  interface
  uses crt, sysutils, vputils;

  var stepx , stepY, movePos, minX, minY, maxX, maxY: LONGINT;

  procedure moveUp;
  procedure moveDown;
  procedure moveLeft;
  procedure moveRight;
  procedure startGrid(moveStepX, moveStepY, startX, startY : LONGINT; boundaries : ARRAY OF LONGINT; var x, y : LONGINT);

  implementation
  procedure moveUp;
    begin
      if WhereY - stepy >= minY THEN
        begin
          movePos := WhereY - stepy;
          GoToXY(WhereX, movePos);
        end;
    end;

  procedure moveDown;
    begin
      if WhereY + stepy <= maxY THEN
        begin
          movePos := WhereY + stepy;
          GoToXY(WhereX, movePos);
        end;
    end;

  procedure moveLeft;
    begin
      if WhereX - stepx >= minX THEN
        begin
          movePos := WhereX - stepx;
          GoToXY(movePos, WhereY);
        end;
    end;

  procedure moveRight;
    begin
      if WhereX + stepx <= maxX THEN
        begin
          movePos := WhereX + stepX;
          GoToXY(movePos, WhereY);
        end;
    end;

  procedure startGrid(moveStepX, moveStepY, startX, startY : LONGINT; boundaries : ARRAY OF LONGINT; var x, y : LONGINT);
    var keyPress : char;
    begin
      stepX := moveStepX;
      stepY := moveStepY;
      minX := boundaries[0];
      minY := boundaries[1];
      maxX := boundaries[2];
      maxY := boundaries[3];
      GoToXY(startX,startY);
      repeat
        keyPress := readkey;
        if keyPress = #0 then
          begin
            case readKey of
              'H' : moveUp;
              'P' : moveDown;
              'K' : moveLeft;
              'M' : moveRight;
            end;
          end;
      until keyPress = #13;
      if stepX <> 0 THEN
        begin
          x := Int((WhereX - startX) / stepX);
        end
      ELSE
        begin
          x := startX;
        end;

      if stepY <> 0 THEN
        y := int((WhereY - startY) / stepY)
      ELSE
        y := startY;
    end;

  end.

