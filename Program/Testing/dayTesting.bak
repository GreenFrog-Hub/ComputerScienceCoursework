PROGRAM dayTesting;
  uses crt, sysutils;

  var day, i : LONGINT;
    startDate : STRING;


  begin
    startDate := '4/11/2024';
    for i := 0 TO 14 DO
      begin
        writeln(DateToStr(StrToDate(startDate)+i),':',DayOfWeek(StrToDate(startDate)+i-1));
        //writeln('i: ', i);
      end;
    //day := DayOfWeek(Date-1);
    //writeln('day:' ,day);
    readln;
  end.
